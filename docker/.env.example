# Copy to docker/.env and edit. docker/.env is gitignored.

# Most people do NOT need this. Run `make plex-claim` instead: it prompts for the
# token and claims the running server, with no reset and no file editing.
#
# This variable only applies on a server's FIRST boot, so it is for automated
# provisioning where the stack is created and claimed in one step. The token
# expires about four minutes after it is issued.
PLEX_CLAIM=

# Host port for the test Plex server. 32400 and 32401 are both avoided: a native
# Plex Media Server binds 32400 publicly and 32401 on loopback.
PLEX_PORT=32402

# Host port for Jellyfin.
JELLYFIN_PORT=8096

TZ=America/Denver

# Written by `make plex-token` after the server is claimed. Every API call this
# project makes authenticates with it, which is what lets ALLOWED_NETWORKS stay
# empty. Treat it like a password; docker/.env is gitignored.
PLEX_TOKEN=

# Deliberately empty. ALLOWED_NETWORKS grants UNAUTHENTICATED access to the whole
# Plex API — including /:/prefs and media deletion — to every address in the listed
# ranges. On a published port that is the entire LAN. Set it only for an unclaimed
# throwaway server, and then to one subnet, never 192.168.0.0/16.
ALLOWED_NETWORKS=
